{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Up",
            "type": "shell",
            "command": "docker-compose up --build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Run Desktop App",
            "type": "shell",
            "command": "python desktop/main.py",
            "dependsOn": ["Install Desktop Requirements"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Install Desktop Requirements",
            "type": "shell",
            "command": "pip install -r desktop/requirements.txt",
            "problemMatcher": []
        }
    ]
}
