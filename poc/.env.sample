DB_CONTAINER_NAME=db
DB_HOST=db
DB_PORT=5432
DB_PORT_HOST=5432
DB_NAME=main

# Superuser used only for database bootstrap/reset/load operations.
DB_ADMIN_USER=dbadmin
DB_ADMIN_PASSWORD=dbadmin

# Least-privileged runtime role used by application and MCP services.
DB_USER=dbuser
DB_PASSWORD=dbuser

PCAP_PROCESSOR_CONTAINER_NAME=pcap-processor
