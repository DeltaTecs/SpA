DB_CONTAINER_NAME=db
DB_HOST=db
DB_PORT=5432
DB_PORT_HOST=5432
DB_NAME=main

# Superuser used only for database bootstrap/reset/load operations.
DB_ADMIN_USER=dbadmin
DB_ADMIN_PASSWORD=dbadmin

# Least-privileged runtime role used by application and MCP services.
DB_USER=dbuser
DB_PASSWORD=dbuser

PCAP_PROCESSOR_CONTAINER_NAME=pcap-processor

# --- LLM scan planning (scanner-backend) ---
# API keys for the keyed LLM providers (local/qwen needs none). Leave unset to
# disable that provider. Keys stay server-side; the UI only picks provider+model.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Tavily web-search remote MCP. When set, the planner LLM also gets web search.
TAVILY_API_KEY=
# --- Tavily cost controls (all optional; defaults shown) ---
# Cache tool results so repeated CVE/product lookups are not re-billed.
TAVILY_CACHE_ENABLED=true
# Persistent cache file (survives restarts). Set empty for in-memory only.
TAVILY_CACHE_PATH=.cache/tavily.sqlite
# How long a cached result stays valid (seconds; default 7 days).
TAVILY_CACHE_TTL_SECONDS=604800
# Max entries kept in the fast in-memory tier.
TAVILY_CACHE_MAX_ENTRIES=1000
# Forced search depth: basic = 1 credit, advanced = 2.
TAVILY_SEARCH_DEPTH=basic
# Cap on results per search (<=0 disables the cap).
TAVILY_MAX_RESULTS=5
# Which Tavily tools the model may use (crawl is the most expensive; off by default).
TAVILY_ALLOW_EXTRACT=true
TAVILY_ALLOW_CRAWL=false
TAVILY_INCLUDE_RAW_CONTENT=false
# Hard ceiling on billable Tavily calls per analysis job (0 = unlimited).
TAVILY_CALL_BUDGET_PER_JOB=0
# Concurrent LLM sessions (one per data exchange) the planner runs at once.
PLAN_MAX_CONCURRENCY=4

# Required shared secret for scanner-backend to stop active HexStrike tools.
# Generate a non-empty random value before starting the Compose stack.
HEXSTRIKE_TOOLS_ADMIN_TOKEN=admintoken

# Optional: when set, HexStrike active-scan traffic egresses through ProtonVPN.
# Leave unset to run HexStrike with normal Docker networking.
PROTONVPN_WIREGUARD_PRIVATE_KEY=
PROTONVPN_SERVER_COUNTRIES=Netherlands
